# WordPress Configuration
WORDPRESS_API_URL=https://example.com/wp-json/wp/v2
WORDPRESS_USERNAME=your-username
WORDPRESS_PASSWORD=your-app-password

# Build Configuration
NODE_ENV=production
SITE_URL=https://example.com

# Form Configuration
FORM_PROVIDER=netlify
FORMSPREE_ENDPOINT=your-formspree-endpoint

# Performance Configuration
ENABLE_CACHE=true
CACHE_TIMEOUT=900

# SEO Configuration
SITE_TITLE=My Technology Journal
SITE_DESCRIPTION=Exploring WordPress, automation, development, and tech insights.
SITE_KEYWORDS=tech, blog, automation, development
SITE_AUTHOR=Your Name
TWITTER_HANDLE=@yourhandle
DEFAULT_OG_IMAGE=/images/og-default.webp

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
