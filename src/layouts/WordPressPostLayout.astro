---
import ProgressBar from "../components/ui/ProgressBar";
import BaseLayout from "./BaseLayout.astro";
import WordPressTitle from "../components/blog/WordPressTitle.astro";
import type { WordPressCategory } from "../lib/types";

interface Props {
  title: string;
  description: string;
  date: string;
  modifiedDate?: string;
  readTime: number;
  categories?: WordPressCategory[];
  relatedPosts?: { title: string; slug: string }[];
  previousPost?: { title: string; slug: string } | null;
  nextPost?: { title: string; slug: string } | null;
  featuredImage?: {
    url: string;
    alt: string;
    width?: number;
    height?: number;
    mimeType?: string;
  } | null;
}

const {
  title,
  description,
  date,
  modifiedDate,
  readTime,
  categories,
  featuredImage,
  relatedPosts = [],
  previousPost,
  nextPost,
} = Astro.props;

// Extract category names for SEO
const categoryNames = categories?.map(cat => cat.name) || [];

 
---

<BaseLayout
  title={title}
  description={description}
  url={Astro.url.href}
  pubDate={new Date(date)}
  modifiedDate={modifiedDate}
  ogimage={featuredImage || undefined}
  article={true}
  categories={categoryNames}
>
  <Fragment slot="head">
    <link
      id="hljs-light"
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/highlight.js@11.10.0/styles/atom-one-light.min.css"
    />
    <link
      id="hljs-dark"
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/highlight.js@11.10.0/styles/atom-one-dark.min.css"
    />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const lightLink = document.getElementById("hljs-light");
        const darkLink = document.getElementById("hljs-dark");
        const prefersDarkMode = () =>
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        const applyTheme = () => {
          const isDark =
            root.classList.contains("dark") ||
            (!root.classList.contains("light") && prefersDarkMode());
          if (darkLink) darkLink.disabled = !isDark;
          if (lightLink) lightLink.disabled = isDark;
        };
        applyTheme();
        new MutationObserver(applyTheme).observe(root, {
          attributes: true,
          attributeFilter: ["class"],
        });
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", applyTheme);
      })();
    </script>
    <script type="module">
      import hljs from "https://cdn.jsdelivr.net/npm/highlight.js@11.10.0/+esm";
      hljs.highlightAll();
    </script>
    <style>
      .code-copy {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        opacity: 0;
        transition: opacity 150ms ease-in-out, transform 150ms ease-in-out;
        transform: translateY(-2px);
      }
      pre:hover .code-copy,
      pre:focus-within .code-copy {
        opacity: 1;
        transform: translateY(0);
      }
    </style>
  </Fragment>
  <ProgressBar client:idle />
  <article>
    <div class="center">
      <WordPressTitle {title} {date} {readTime} {categories} />
      <section class="markdown wordpress-content">
        <slot />
      </section>
      {(relatedPosts.length > 0 || previousPost || nextPost) && (
        <div class="mt-10 space-y-6">
          {relatedPosts.length > 0 && (
            <div class="space-y-2">
              <div class="text-xs uppercase tracking-[0.18em] text-foreground/50">
                Related posts
              </div>
              <ul class="space-y-1 text-sm">
                {relatedPosts.map((related) => (
                  <li>
                    <a class="link" href={`/${related.slug}/`}>
                      {related.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {(previousPost || nextPost) && (
            <div class="grid gap-4 text-sm sm:grid-cols-2">
              <div>
                {previousPost && (
                  <a class="link block" href={`/${previousPost.slug}/`}>
                    <div class="text-xs uppercase tracking-[0.18em] text-foreground/50">
                      Previous
                    </div>
                    <div class="mt-1">{previousPost.title}</div>
                  </a>
                )}
              </div>
              <div class="sm:text-right">
                {nextPost && (
                  <a class="link block" href={`/${nextPost.slug}/`}>
                    <div class="text-xs uppercase tracking-[0.18em] text-foreground/50">
                      Next
                    </div>
                    <div class="mt-1">{nextPost.title}</div>
                  </a>
                )}
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<script type="module">
  const preBlocks = Array.from(
    document.querySelectorAll(".wordpress-content pre")
  );

  preBlocks.forEach((pre) => {
    const code = pre.querySelector("code");
    if (!code) return;

    const text = code.textContent || "";
    pre.style.position = "relative";

    const button = document.createElement("button");
    button.type = "button";
    button.className =
      "code-copy inline-flex items-center justify-center size-9 rounded-md bg-background/80 ring-1 ring-foreground/20 text-foreground";
    button.setAttribute("aria-label", "Copy code");
    button.innerHTML = `
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4">
        <path
          fill="currentColor"
          d="M16 1H6a2 2 0 0 0-2 2v12h2V3h10V1zm3 4H10a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H10V7h9v14z"
        />
      </svg>
      <span class="code-copy-text" aria-live="polite"></span>
      <span class="sr-only">Copy code</span>
    `;
    button.style.position = "absolute";
    button.style.top = "0.75rem";
    button.style.right = "0.75rem";

    button.addEventListener("click", async () => {
      const activeClasses = ["code-copy-active"];
      const textEl = button.querySelector(".code-copy-text");
      try {
        await navigator.clipboard.writeText(text);
        button.classList.add(...activeClasses);
        if (textEl) textEl.textContent = "Copied";
        setTimeout(() => {
          button.classList.remove(...activeClasses);
          if (textEl) textEl.textContent = "";
        }, 1200);
      } catch {
        button.classList.add(...activeClasses);
        if (textEl) textEl.textContent = "Failed";
        setTimeout(() => {
          button.classList.remove(...activeClasses);
          if (textEl) textEl.textContent = "";
        }, 1200);
      }
    });

    pre.appendChild(button);
  });
</script>
