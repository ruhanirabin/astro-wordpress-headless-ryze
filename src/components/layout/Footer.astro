---
import { siteConfig } from "../../lib/site-config";
import Socials from "../ui/Socials.astro";
---

<footer class="footer-margin sticky bottom-0 z-0">
  <Socials />
  <div
    class="text-foreground/50 flex items-center justify-between text-sm select-none"
  >
    <p>© {siteConfig.copyrightText} <a
        href="https://www.ruhanirabin.com"
        target="blank"
        class="hover:text-accent"
        aria-label="astro site">{siteConfig.author}</a
      ></p>
    <p>
      powered by <a
        href="https://astro.build"
        target="blank"
        class="hover:text-accent"
        aria-label="astro site">Astro + WP</a
      >
    </p>
  </div>
</footer>
