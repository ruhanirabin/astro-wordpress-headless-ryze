---
import type { WordPressPost, WordPressCategory } from "../../lib/types";
import { resolvePostCategories } from "../../lib/wordpress";
import IconArrowRight from "../../assets/icons/arrow-right.svg";

interface Props {
  post: WordPressPost;
  categoryMap?: Map<number, WordPressCategory>;
}

const { post, categoryMap } = Astro.props;

const getDateParts = (dateString: string) => {
  const date = new Date(dateString);
  return {
    day: date.toLocaleDateString("en-GB", { day: "2-digit" }),
    month: date.toLocaleDateString("en-GB", { month: "short" }),
  };
};

const dateParts = getDateParts(post.date);
// Resolve category IDs to category objects
const categories = categoryMap 
  ? resolvePostCategories(post, categoryMap)
  : [];
---

<a
  href={`/${post.slug}`}
  class="hover:bg-accent ring-background hover:ring-accent group animation flex h-full flex-col gap-2 rounded-lg shadow-lg ring-3 select-none hover:shadow-none hover:ring-3 active:ring-0 dark:shadow-2xl"
>
  <div class="mx-4 mt-2 flex items-start justify-between gap-6">
    <div class="flex items-start gap-3">
      <h3
        class="text-foreground group-hover:text-background animation self-start rounded-lg text-xl opacity-90 group-hover:font-semibold group-hover:tracking-wide line-clamp-2"
        set:html={post.title.rendered}
      />
    </div>
    <div class="ml-auto flex items-start gap-2">
      <p class="animation mt-1 text-sm opacity-80 group-hover:text-[0rem] group-hover:opacity-0 text-right min-w-[3.75rem] leading-tight">
        <span class="block sm:inline">{dateParts.day}</span>
        <span class="block sm:inline sm:ml-1">{dateParts.month}</span>
      </p>
      <IconArrowRight
        class="stroke-background animation size-0 stroke-2 group-hover:size-6"
      />
    </div>
  </div>
  
  {categories.length > 0 && (
    <div class="mx-3 flex flex-wrap">
      {categories.map((cat) => (
        <p class="ring-foreground bg-background animation mx-1 flex items-center gap-1 rounded-lg px-3 pb-0.5 text-[0rem] opacity-90 group-hover:mb-3 group-hover:text-sm">
          {cat.name}
        </p>
      ))}
    </div>
  )}
</a>
