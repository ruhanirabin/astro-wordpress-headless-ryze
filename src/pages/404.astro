---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 - Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <div class="center flex flex-col items-center justify-center min-h-[60vh]">
    <h1 class="text-9xl font-bold text-accent">404</h1>
    <h2 class="text-3xl font-semibold mt-4">Page Not Found</h2>
    <p class="paragraph mt-4 text-center">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="button mt-8"
    >
      Go Home
    </a>
  </div>
</BaseLayout>
